# ── One Delivery Driver App — Environment Variables ──────────────────
# Copy to .env and replace with your production values. NEVER commit .env.

# Backend API base URL (include /api, no trailing slash)
EXPO_PUBLIC_API_URL=https://api.onedelivery.co.tz/api
# Socket.io server URL (same host as backend, WITHOUT /api)
EXPO_PUBLIC_SOCKET_URL=https://api.onedelivery.co.tz

# Google Maps keys (enable Maps SDK Android/iOS + Directions API)
EXPO_PUBLIC_GOOGLE_MAPS_ANDROID_KEY=YOUR_ANDROID_MAPS_KEY
EXPO_PUBLIC_GOOGLE_MAPS_IOS_KEY=YOUR_IOS_MAPS_KEY
EXPO_PUBLIC_GOOGLE_DIRECTIONS_KEY=YOUR_DIRECTIONS_API_KEY

# Phone OTP verification — disabled for now, ready to enable later
EXPO_PUBLIC_ENABLE_OTP=false
EXPO_PUBLIC_APP_ENV=production
